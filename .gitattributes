# Zeilenenden
* text=auto eol=lf
*.png binary
*.webp binary
*.ico binary
*.icns binary

# Drittanbieter-Bibliotheken
public/cdn/** linguist-vendored
leptos-ui/public/cdn/** linguist-vendored
public/app_components/** linguist-vendored
leptos-ui/public/app_components/** linguist-vendored
**/Animate.css linguist-vendored

# Generierte Dateien
assets/tailwind.css linguist-generated
Cargo.lock linguist-generated
**/Cargo.lock linguist-generated

# Playwright-E2E-Suiten (Test-Harness, nicht Teil der Bibliothek)
e2e/** linguist-vendored
leptos-ui/e2e/** linguist-vendored

# Styles, Build-, Plattform- und Hilfsdateien
*.css linguist-detectable=false
*.ts linguist-detectable=false
*.js linguist-detectable=false
*.mjs linguist-detectable=false
*.html linguist-detectable=false
*.sh linguist-detectable=false
*.m linguist-detectable=false
*.sql linguist-detectable=false
justfile linguist-detectable=false
**/justfile linguist-detectable=false
Dockerfile linguist-detectable=false
**/Dockerfile linguist-detectable=false
.githooks/** linguist-detectable=false
